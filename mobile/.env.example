# mobile/.env.local olarak kopyala ve doldur. .env.local git'e girmez.
#
# UYARI: EXPO_PUBLIC_* değişkenleri derlemede pakete GÖMÜLÜR ve okunabilir.
# Buraya yalnızca herkese açık olması sorun olmayan değerler konur.
# Service role anahtarı, SIM808 ön paylaşımlı anahtarı ve cihaz device token'ı ASLA buraya yazılmaz.
# Güvenlik, her tabloda açık ve varsayılan reddet olan RLS politikalarından gelir.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
